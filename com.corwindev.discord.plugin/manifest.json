{
    "name": "Discord",
    "uuid": "com.corwindev.discord",
    "version": "1.0.2",
    "author": "CorwinDev",
    "entry": "backend/plugin.cjs",
    "description": "Use Discord Voice controls and soundboard!",
    "repo": "https://github.com/CorwinDev/Flexbar-Discord",
    "sdk": {
        "version": "1.0.0"
    },
    "software": {
        "minimumVersion": "1.0.0"
    },
    "os": [
        {
            "platform": "mac",
            "minimumVersion": "10.15"
        },
        {
            "platform": "windows",
            "minimumVersion": "10"
        },
        {
            "platform": "linux",
            "minimumVersion": "20.04"
        }
    ],
    "device": [
        {
            "name": "flexbar",
            "version": "1.0.0"
        }
    ],
    "configPage": "configPage",
    "keyLibrary": {
        "title": "Discord",
        "style": {
            "icon": "data:image/png;base64,"
        },
        "children": [
            {
                "title": "$Soundboard.Title",
                "tip": "$Soundboard.Tip",
                "cid": "com.corwindev.discord.soundboard",
                "config": {
                    "keyType": "default",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac",
                        "linux"
                    ]
                },
                "style": {
                    "icon": "mdi mdi-bullhorn-outline",
                    "width": 240
                },
                "data": {
                    "name": "",
                    "sound_id": 0,
                    "guild_id": 0
                }
            },
            {
                "title": "$Mute.Title",
                "tip": "$Mute.Tip",
                "cid": "com.corwindev.discord.mute",
                "config": {
                    "keyType": "multiState",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac",
                        "linux"
                    ],
                    "multiState": {
                        "defaultState": 0
                    }
                },
                "style": {
                    "icon": "data:image/png;base64,",
                    "width": 240,
                    "multiStyle": [
                        {
                            "icon": "data:image/png;base64,",
                            "showIcon": true
                        },
                        {
                            "icon": "data:image/png;base64,",
                            "showIcon": true
                        }
                    ],
                    "flags": [
                        "multi-style"
                    ]
                },
                "data": {}
            },
            {
                "title": "$Deafen.Title",
                "tip": "$Deafen.Tip",
                "cid": "com.corwindev.discord.deafen",
                "config": {
                    "keyType": "multiState",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac",
                        "linux"
                    ],
                    "multiState": {
                        "defaultState": 0
                    }
                },
                "style": {
                    "icon": "data:image/png;base64,",
                    "width": 240,
                    "multiStyle": [
                        {
                            "icon": "data:image/png;base64,",
                            "showIcon": true
                        },
                        {
                            "icon": "data:image/png;base64,",
                            "showIcon": true
                        }
                    ],
                    "flags": [
                        "multi-style"
                    ]
                },
                "data": {}
            },
            {
                "title": "$Camera.Title",
                "tip": "$Camera.Tip",
                "cid": "com.corwindev.discord.camera",
                "config": {
                    "keyType": "default",
                    "clickable": true,
                    "platform": [
                        "windows",
                        "mac",
                        "linux"
                    ]
                },
                "style": {
                    "icon": "mdi mdi-camera",
                    "width": 240
                },
                "data": {}
            }
        ]
    },
    "local": {
        "en": {
            "PluginName": "Discord",
            "Soundboard": {
                "Title": "Trigger Soundboard",
                "Tip": "Trigger soundboard sound on Discord",
                "UI": {
                    "Label": "Soundboard"
                }
            },
            "Mute": {
                "Title": "Mute/Unmute",
                "Tip": "Mute/Unmute Discord",
                "UI": {
                    "Label": "Mute/Unmute"
                }
            },
            "Deafen": {
                "Title": "Deafen/Undeafen",
                "Tip": "Deafen/Undeafen Discord",
                "UI": {
                    "Label": "Deafen/Undeafen"
                }
            },
            "Camera": {
                "Title": "Camera",
                "Tip": "Toggle camera on Discord",
                "UI": {
                    "Label": "Camera"
                }
            }
        }
    }
}
